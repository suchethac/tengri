# Snapshot regression baselines are checked in (small, deterministic).
!tests/_data/kernel_snapshots/*.npy
!tests/regression/data/dust_emission_golden/*.npy

# Jupyter
.ipynb_checkpoints/

# Jupytext: .py files are source of truth.
# Spine notebooks (numeric-prefixed) are kept executed for GitHub rendering.
notebooks/*.ipynb
!notebooks/[0-9][0-9]_*.ipynb

# Testing
.pytest_cache/
htmlcov/
.coverage
data/cloudy_raw/*.cont
data/cloudy_raw/*.lines
data/dl07_raw/
data/dl14_raw/
data/*.h5
!data/skirtor_templates_v3.h5
!data/nthcomp_templates.h5
!data/nenkova08_torus_grid.h5
# Vendored AGNfitter-rX reference grids — keep crossvals CI-runnable (#613).
# Regenerate with: python scripts/build_<name>.py --download  (no AGNfitter install needed)
!data/agnfitter_bbb_reference.h5
!data/skirtor_mean3p_torus_grid.h5
!data/cat3d_wind_torus_grid.h5
!data/silva04_torus_grid.h5
# Fritz+2006 torus grid (#347/#804). Regenerate with:
#   python scripts/download_fritz2006_templates.py && python scripts/build_fritz2006_grid.py
!data/fritz2006_torus_grid.h5
!data/slone_netzer_disc_grid.h5
!data/wg00_attenuation_grid.h5
# wg00_attenuation_grid.h5 (~95 KB): regenerate with python scripts/build_wg00_grid.py --download
# Regenerate with: python scripts/convert_fsps_cloudy_grid.py && python scripts/convert_dl07_templates.py
# nthcomp_templates.h5 (~14 MB): regenerate with python scripts/build_nthcomp_templates.py

# Notebook figure outputs (should be in notebooks/*/figures/)
fig*.png
fig*.pdf
notebooks/*/figures/
models/figures/
specialist/figures/

# Stray root-level images (paper figures live in docs/_static/figures/)
/*.png
/*.pdf

# Internal research outputs (not for distribution)
analysis/figures/
explore/
profiling/
notebook_execution.log
notebook_metrics.json

# Sphinx docs build artifacts
docs/_build/
docs/_notebooks/
docs/build.log
# docs/auto_examples/ is committed (pre-rendered locally) so the docs build
# in CI doesn't need SSP grids or RELAGN — see docs/conf.py plot_gallery.
# Re-run `make html` locally and commit changes when galleries need refresh.
# docs/auto_examples/
.worktrees/
.claude/
.nb_home/

# Notebook runtime data caches (SVO filter pulls, etc.)
notebooks/data/
examples/*/data/filters/
examples/*/data/
arxiv_library/
_galrun/

# Superpowers subagent-driven-development scratch ledger (session-local)
.superpowers/
!data/grahsp/grahsp_templates.h5
