*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# JAX/CUDA
*.npy
*.npz
*.hdf5
*.h5
# Downloader collision suffixes. curl -O and wget append .1, .2, ... rather
# than overwriting, and the result does not match the extension patterns above:
# `foo.h5.1` is not `*.h5`. That is not hypothetical -- a second fetch of the
# 64 MB bare-stellar SSP grid landed as data/fsps_prsc_miles_chabrier.h5.1 and
# was committed, then deleted. It is gone from the tree and still costs 58.7 MB
# of pack, the single largest dead blob in this repository's history, because
# deleting a file does not unsend it.
*.h5.*
*.hdf5.*
*.npz.*
*.npy.*
# Snapshot regression baselines are checked in (small, deterministic).
!tests/_data/kernel_snapshots/*.npy
!tests/regression/data/dust_emission_golden/*.npy

# Jupyter
.ipynb_checkpoints/

# Jupytext: .py files are source of truth.
# Spine notebooks (numeric-prefixed) are kept executed for GitHub rendering.
notebooks/*.ipynb
!notebooks/[0-9][0-9]_*.ipynb

# Testing
.pytest_cache/
htmlcov/
.coverage
data/cloudy_raw/*.cont
data/cloudy_raw/*.lines
data/dl07_raw/
data/dl07_raw
data/dl14_raw/
data/dl14_raw
data/synthesizer_grids/
data/synthesizer_grids
# Generated CIGALE→DSPS reproduction artifact (bc03_from_cigale.h5, ~400 MB;
# built on demand by reproduction/cigale/_drivers/cigale_ssp_to_dsps.py).
# The path itself is ignored so a stray `data` symlink can't be committed
# again (a self-referential symlink slipped in via #1035).
reproduction/cigale/_drivers/data
data/*.h5
# ── The two SSP grids the gallery needs, committed on purpose (#1146) ──
# CI could not execute a single example without these, so a broken example
# shipped next to a stale figure (see tools/run_gallery_examples.py). The wNE
# default is what `tengri.load_ssp()` resolves to and is NOT downloadable
# (404 on the SSP host), so it has to live here. The bare-stellar grid IS
# downloadable, but at 64 MB it is committed by explicit decision rather than
# fetched-and-cached: it makes a fresh clone — and CI — work with no network.
# This is a deliberate exception to the "<10 MB gets committed" rule.
!data/ssp_prsc_miles_chabrier_wNE_logGasU-3.0_logGasZ0.0.h5
!data/fsps_prsc_miles_chabrier.h5
# RELAGN disc grid (26 MB). `examples/agn/plot_agn_disc_compare.py` plots it, and
# it CANNOT be rebuilt in CI: scripts/build_relagn_disc_grid.py needs a conda env
# with XSPEC. Without it that example raised FileNotFoundError for every user who
# does not have XSPEC — which is everyone — while its committed figure showed the
# curve anyway.
!data/relagn_disc_grid.h5
!data/skirtor_templates_v3.h5
!data/nthcomp_templates.h5
!data/nenkova08_torus_grid.h5
# Vendored AGNfitter-rX reference grids — keep crossvals CI-runnable (#613).
# Regenerate with: python scripts/build_<name>.py --download  (no AGNfitter install needed)
!data/agnfitter_bbb_reference.h5
!data/skirtor_mean3p_torus_grid.h5
!data/cat3d_wind_torus_grid.h5
!data/silva04_torus_grid.h5
!data/nenkova_agnfitter_torus_grid.h5
!data/dh02_ce01_grid.h5
# Fritz+2006 torus grid (#347/#804). Regenerate with:
#   python scripts/download_fritz2006_templates.py && python scripts/build_fritz2006_grid.py
!data/fritz2006_torus_grid.h5
!data/slone_netzer_disc_grid.h5
!data/wg00_attenuation_grid.h5
# wg00_attenuation_grid.h5 (~95 KB): regenerate with python scripts/build_wg00_grid.py --download
# Regenerate with: python scripts/convert_fsps_cloudy_grid.py && python scripts/convert_dl07_templates.py
# nthcomp_templates.h5 (~14 MB): regenerate with python scripts/build_nthcomp_templates.py

# Notebook figure outputs (should be in notebooks/*/figures/)
fig*.png
fig*.pdf
notebooks/*/figures/
models/figures/
specialist/figures/

# Stray root-level images (paper figures live in docs/_static/figures/)
/*.png
/*.pdf

# Gallery scripts savefig locally for standalone runs; the committed copies
# live in docs/auto_examples/*/images/ (sphinx-gallery scrapes open figures,
# it never reads these).
examples/**/*.png

# Internal research outputs (not for distribution)
#
# Anchored with a leading slash: these name directories at the REPO ROOT.
# Unanchored, `profiling/` also matched `src/tengri/profiling/` -- a real,
# tracked package -- and ruff respects .gitignore inside a git repository, so
# CI silently linted 1464 files instead of 1468 and those four were invisible
# to `ruff check`. Two defects sat in them unreported (#1598). Keep the slash;
# `explore/` had the same latent hazard and is anchored for the same reason.
analysis/figures/
/explore/
/profiling/
notebook_execution.log
notebook_metrics.json

# Sphinx docs build artifacts
docs/_build/
docs/_notebooks/
docs/build.log
# docs/auto_examples/ is committed (pre-rendered locally) so the docs build
# in CI doesn't need SSP grids or RELAGN — see docs/conf.py plot_gallery.
# Re-run `make html` locally and commit changes when galleries need refresh.
# docs/auto_examples/
.worktrees/
.claude/
.nb_home/

# Notebook runtime data caches (SVO filter pulls, etc.)
notebooks/data/
examples/*/data/filters/
examples/*/data/
arxiv_library/
_galrun/

# Superpowers subagent-driven-development scratch ledger (session-local)
.superpowers/

# Audit/scratch scripts must live in tests/ — never the repo root. Tests are
# collected from tests/ only (pyproject testpaths=["tests"]), so a root-level
# test_*.py is unreachable dead weight. Ignoring them here stops a `git add -A`
# from re-leaking audit scratch, as happened in #1165 (see #1232).
/test_*.py
/*_test.py
/audit_*.py
/*_audit.py
/quick_test*.py
/final_audit*.py
!data/grahsp/grahsp_templates.h5
!data/qsogen_emline_template.h5
!data/qsogen_detailed_reference.npz
!data/external_sed_reference.npz
!data/feltre_grid.h5
!data/mappings_templates.h5
!data/schreiber2018_templates.h5
!data/bpss_stars_c3k_a_chabrier.h5
!data/flury2024_grids.h5

